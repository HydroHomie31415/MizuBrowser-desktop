# Extensions shipped with Mizu.
#
# Pinned by version and SHA-256 the same way config/upstream.env pins Firefox:
# the XPI is downloaded and verified at build time rather than committed, so
# this repository stays source-only and the build stays reproducible.
#
# These are the Mozilla-signed builds published by each extension's author. The
# signature is what lets them install without weakening xpinstall.signatures.
# Do not repackage or modify them: an altered XPI loses its signature, and
# redistributing a modified add-on under its original name is a trademark
# problem on top of a technical one.
#
# To update: change the version, run './mizu extensions --update-checksum' to
# print the new SHA-256, paste it in, and commit both.

# uBlock Origin. GPL-3.0-or-later. https://github.com/gorhill/uBlock
# The add-on ID is taken from the XPI's own manifest and must match exactly;
# distribution add-ons are installed by filename.
UBLOCK_ORIGIN_ID=uBlock0@raymondhill.net
UBLOCK_ORIGIN_VERSION=1.72.2
UBLOCK_ORIGIN_SHA256=40c315b0da7871868155ecfae7a50a58dfa0920aebd865e008214986f1b7c578
UBLOCK_ORIGIN_URL=https://github.com/gorhill/uBlock/releases/download/%VERSION%/uBlock0_%VERSION%.firefox.signed.xpi

# Space-separated list of the prefixes above.
MIZU_EXTENSIONS="UBLOCK_ORIGIN"
