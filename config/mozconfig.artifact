# Fast mode for JavaScript, CSS, browser UI, preferences, and branding work.
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-mizu-artifact
mk_add_options AUTOCLOBBER=1

ac_add_options --enable-artifact-builds
ac_add_options --with-branding=browser/branding/mizu
# Artifact builds reuse Firefox's precompiled launcher, so its basename must
# remain Firefox. Full builds compile the native Mizu launcher.
ac_add_options --with-distribution-id=org.mizubrowser
ac_add_options MOZ_APP_REMOTINGNAME=mizu
ac_add_options MOZ_PKG_APPNAME=mizu
