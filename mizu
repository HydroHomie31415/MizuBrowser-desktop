set -euo pipefail

PROJECT_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
command_name=${1:-help}
if (($# > 0)); then
  shift
fi

usage() {
  cat <<'EOF'
Usage: ./mizu <command> [arguments]

Commands:
  doctor          Check build prerequisites
  fetch           Download the pinned Firefox source
  bootstrap       Fetch source and install Mozilla build prerequisites
  sync            Install branding, product files, and patches
  build           Build the selected configuration
  extensions      Install the bundled extensions into the build
  run             Run Mizu with an isolated development profile
  package         Create a release-style package
  arch-package    Create a pacman-installable Arch Linux package
  clobber         Clean the selected Firefox object directory
  upstream-check  Compare the source pin with upstream main
  auto-update     Rebuild against the newest upstream commit and stage a package
  status          Show configuration and checkout state
  test            Validate this repository without fetching Firefox
  help            Show this help

Environment:
  MIZU_BUILD_MODE=artifact|full   Select build mode (default: artifact)
  MIZU_DEV_PROFILE=/path         Override the isolated run profile
EOF
}

case "$command_name" in
  doctor|fetch|bootstrap|sync|build|status|test|extensions|arch-package)
    exec "$PROJECT_ROOT/scripts/$command_name.sh" "$@"
    ;;
  upstream-check)
    exec "$PROJECT_ROOT/scripts/upstream-check.sh" "$@"
    ;;
  auto-update)
    exec "$PROJECT_ROOT/scripts/auto-update.sh" "$@"
    ;;
  run)
    # shellcheck source=scripts/common.sh
    source "$PROJECT_ROOT/scripts/common.sh"
    "$PROJECT_ROOT/scripts/sync.sh"
    profile=${MIZU_DEV_PROFILE:-"$PROJECT_ROOT/.cache/profile-$(build_mode)"}
    mkdir -p "$profile"
    exec_mach run --profile "$profile" --no-remote "$@"
    ;;
  package)
    # shellcheck source=scripts/common.sh
    source "$PROJECT_ROOT/scripts/common.sh"
    "$PROJECT_ROOT/scripts/sync.sh"
    exec_mach package "$@"
    ;;
  clobber)
    # shellcheck source=scripts/common.sh
    source "$PROJECT_ROOT/scripts/common.sh"
    exec_mach clobber "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
