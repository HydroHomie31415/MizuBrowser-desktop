# Add the Mizu mouse gestures pane to settings: register it, put it in the
# category list, and package its module, editor widget, icon and strings.
#
# The pane is declared the way Firefox's own redesigned panes are, so it gets
# the category button, search and sub-pane handling for free. The editor widget
# keeps no state: it reads and writes the mizu.gestures.pattern. branch
# directly, so a gesture added here and one added in about:config are the same
# thing. See browser/components/preferences/config/mizu-gestures.mjs.
#
# Recording a gesture is done by the browser, not by this page: the pane sets
# mizu.gestures.recording and the window's gesture handler hands the next
# stroke back through mizu.gestures.recorded. That way a stroke is read by the
# same recogniser that will interpret it later, rather than by a second one
# here that could disagree with it.
#
# Strings live in Mizu's own mizuGestures.ftl rather than in Firefox's
# preferences.ftl, which upstream rewrites and localises; keeping them apart
# means a Firefox update cannot collide with them.
#
# As with the gestures patch itself, each addition sits outside the context of
# the Mizu patches before it, so every patch still applies and reverses alone.
diff --git a/browser/components/preferences/jar.mn b/browser/components/preferences/jar.mn
diff --git a/browser/components/preferences/jar.mn b/browser/components/preferences/jar.mn
--- a/browser/components/preferences/jar.mn
+++ b/browser/components/preferences/jar.mn
@@ -57,6 +57,9 @@ browser.jar:
    content/browser/preferences/widgets/placeholder-message.css          (widgets/placeholder-message/placeholder-message.css)
    content/browser/preferences/widgets/nav-notice.mjs                   (widgets/nav-notice/nav-notice.mjs)
    content/browser/preferences/widgets/nav-notice.css                   (widgets/nav-notice/nav-notice.css)
+   content/browser/preferences/config/mizu-gestures.mjs                 (config/mizu-gestures.mjs)
+   content/browser/preferences/widgets/mizu-gesture-list.mjs            (widgets/mizu-gesture-list/mizu-gesture-list.mjs)
+   content/browser/preferences/widgets/mizu-gesture-list.css            (widgets/mizu-gesture-list/mizu-gesture-list.css)
    content/browser/preferences/widgets/setting-control.css              (widgets/setting-control/setting-control.css)
    content/browser/preferences/widgets/setting-control.mjs              (widgets/setting-control/setting-control.mjs)
    content/browser/preferences/widgets/setting-group.mjs                (widgets/setting-group/setting-group.mjs)
diff --git a/browser/components/preferences/preferences.js b/browser/components/preferences/preferences.js
